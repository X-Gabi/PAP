void displayExceededDepartments(void)
{
    int i, found = 0;

    printHeader("DEPARTMENTS OVER BUDGET");
    for (i = 0; i < deptCount; i++) {
        if (deptSpent[i] > deptAllocated[i]) {
            printf("%-16s over by N$%.2f\n", deptName[i],
                   deptSpent[i] - deptAllocated[i]);
            found++;
        }
    }
    if (found == 0)
        printf("No department has exceeded its budget.\n");
}

