void searchSupplier(void)
{
    char term[SUP_NAME_LEN];
    int option, i, found = 0;

    printHeader("SEARCH SUPPLIER");
    if (supCount == 0) {
        printf("No suppliers have been registered yet.\n");
        return;
    }
    printf("1. Search by Supplier ID (exact)\n");
    printf("2. Search by name (partial)\n");
    printf("3. Search by town (partial)\n");
    option = readIntInRange("Choose search type: ", 1, 3);
    readRequiredString("Search for: ", term, SUP_NAME_LEN);

    printf("\n");
    printSupplierHeader();
    for (i = 0; i < supCount; i++) {
        int match;
        if (option == 1)
            match = equalsIgnoreCase(supId[i], term);
        else if (option == 2)
            match = containsIgnoreCase(supName[i], term);
        else
            match = containsIgnoreCase(supTown[i], term);

        if (match) {
            printSupplierRow(i);
            found++;
        }
    }
    if (found == 0)
        printf("No matching supplier found.\n");
    else
        printf("\n%d supplier(s) found.\n", found);
}

void compareSuppliers(void)
{
    char id1[SUP_ID_LEN], id2[SUP_ID_LEN];
    char label1[100], label2[100], low1[SUP_NAME_LEN], low2[SUP_NAME_LEN];
    int a, b, order;

    printHeader("COMPARE TWO SUPPLIERS");
    if (supCount < 2) {
        printf("At least two suppliers are needed to compare.\n");
        return;
    }
    readRequiredString("First supplier ID: ", id1, SUP_ID_LEN);
    readRequiredString("Second supplier ID: ", id2, SUP_ID_LEN);
    a = findSupplierById(id1);
    b = findSupplierById(id2);
    if (a == -1 || b == -1) {
        printf("One or both supplier IDs were not found.\n");
        return;
    }
    if (a == b) {
        printf("Please enter two different suppliers.\n");
        return;
    }

    /* build a readable label "Name - Town" for each supplier */
    strcpy(label1, supName[a]);
    strcat(label1, " - ");
    strcat(label1, supTown[a]);
    strcpy(label2, supName[b]);
    strcat(label2, " - ");
    strcat(label2, supTown[b]);

    printf("\nSupplier 1: %s (%s)\n", label1, supEmail[a]);
    printf("Supplier 2: %s (%s)\n", label2, supEmail[b]);
    printLine('-', LINE_WIDTH);

    if (equalsIgnoreCase(supTown[a], supTown[b]))
        printf("Location : both suppliers are in %s.\n", supTown[a]);
    else
        printf("Location : different towns (%s and %s).\n", supTown[a], supTown[b]);

    toLowerCopy(supName[a], low1, SUP_NAME_LEN);
    toLowerCopy(supName[b], low2, SUP_NAME_LEN);
    order = strcmp(low1, low2);
    if (order == 0)
        printf("Name     : both suppliers have the same name.\n");
    else if (order < 0)
        printf("Name     : %s comes before %s alphabetically.\n", supName[a], supName[b]);
    else
        printf("Name     : %s comes before %s alphabetically.\n", supName[b], supName[a]);

    printf("Name size: %d characters vs %d characters.\n",
           (int)strlen(supName[a]), (int)strlen(supName[b]));
}

