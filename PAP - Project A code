void assetReport(void)
{
    int t, i, n, count = getAssetCount();
    double total = 0.0;

    displayAssets();
    if (count == 0)
        return;

    for (i = 0; i < count; i++)
        total += getAssetValue(i);

    printf("\nAssets by type:\n");
    for (t = 0; t < ASSET_TYPE_COUNT; t++) {
        n = 0;
        for (i = 0; i < count; i++) {
            if (strcmp(getAssetType(i), getAssetTypeName(t)) == 0)
                n++;
        }
        printf("  %-10s : %d\n", getAssetTypeName(t), n);
    }
    printf("\nTotal purchase value of all assets: N$%.2f\n", total);
}

