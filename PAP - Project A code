static char supId[MAX_SUPPLIERS][SUP_ID_LEN];
static char supName[MAX_SUPPLIERS][SUP_NAME_LEN];
static char supEmail[MAX_SUPPLIERS][SUP_EMAIL_LEN];
static char supPhone[MAX_SUPPLIERS][SUP_PHONE_LEN];
static char supTown[MAX_SUPPLIERS][SUP_TOWN_LEN];
static int  supCount = 0;

int findSupplierById(const char *id)
{
    int i;
    for (i = 0; i < supCount; i++) {
        if (equalsIgnoreCase(supId[i], id))
            return i;
    }
    return -1;
}

int getSupplierCount(void) { return supCount; }

static void storeSupplier(const char *id, const char *name, const char *email,
                          const char *phone, const char *town)
{
    strcpy(supId[supCount], id);
    strcpy(supName[supCount], name);
    strcpy(supEmail[supCount], email);
    strcpy(supPhone[supCount], phone);
    strcpy(supTown[supCount], town);
    supCount++;
}

static void printSupplierHeader(void)
{
    printf("%-8s %-20s %-26s %-15s %-10s\n",
           "ID", "Supplier", "Email", "Telephone", "Town");
