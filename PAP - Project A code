/* ===================== REPORTS ===================== */
void employeeReport(void)
{
    int i, count = getEmployeeCount();
    int highIdx = 0, lowIdx = 0;
    double total = 0.0, gross;

    printHeader("EMPLOYEE REPORT");
    if (count == 0) {
        printf("No employees have been recorded yet.\n");
        return;
    }
    for (i = 0; i < count; i++) {
        gross = getEmployeeGross(i);
        total += gross;
        if (gross > getEmployeeGross(highIdx)) highIdx = i;
        if (gross < getEmployeeGross(lowIdx))  lowIdx = i;
    }
    printf("Total Employees : %d\n", count);
    printf("Average Salary  : N$%.2f\n", total / count);
    printf("Highest Salary  : N$%.2f (%s)\n", getEmployeeGross(highIdx), getEmployeeName(highIdx));
    printf("Lowest Salary   : N$%.2f (%s)\n", getEmployeeGross(lowIdx),  getEmployeeName(lowIdx));
    printf("Monthly Payroll : N$%.2f (gross)\n", total);
    printf("\nNote: salary figures are gross (basic + allowances).\n");
}

void budgetReport(void)
{
    int i, count = getBudgetCount(), over = 0;
    double allocated = 0.0, spent = 0.0;

    printHeader("BUDGET REPORT");
    if (count == 0) {
        printf("No department budgets have been entered yet.\n");
        return;
    }
    for (i = 0; i < count; i++) {
        allocated += getBudgetAllocated(i);
        spent += getBudgetSpent(i);
    }
    printf("Total Allocated Budget : N$%.2f\n", allocated);
    printf("Total Expenditure      : N$%.2f\n", spent);
    printf("Remaining Budget       : N$%.2f\n", calculateRemaining(allocated, spent));

    printf("\nDepartments exceeding budget:\n");
    for (i = 0; i < count; i++) {
        if (getBudgetSpent(i) > getBudgetAllocated(i)) {
            printf("  - %-14s over by N$%.2f\n", getBudgetName(i),
                   getBudgetSpent(i) - getBudgetAllocated(i));
            over++;
        }
    }
    if (over == 0)
        printf("  None - all departments are within budget.\n");
    else
        printf("\n%d of %d department(s) exceeded their budget.\n", over, count);
}

