}

static void printSupplierRow(int i)
{
    printf("%-8.8s %-20.20s %-26.26s %-15.15s %-10.10s\n",
           supId[i], supName[i], supEmail[i], supPhone[i], supTown[i]);
}

void addSupplier(void)
{
    char id[SUP_ID_LEN], name[SUP_NAME_LEN], email[SUP_EMAIL_LEN];
    char phone[SUP_PHONE_LEN], town[SUP_TOWN_LEN];

    printHeader("ADD SUPPLIER");
    if (supCount >= MAX_SUPPLIERS) {
        printf("The supplier list is full (%d suppliers).\n", MAX_SUPPLIERS);
        return;
    }
    while (1) {
        readRequiredString("Supplier ID (e.g. S001): ", id, SUP_ID_LEN);
        if (findSupplierById(id) == -1)
            break;
        printf("  Error: a supplier with ID %s already exists.\n", id);
    }
    readRequiredString("Supplier name: ", name, SUP_NAME_LEN);
    while (1) {
        readRequiredString("Email: ", email, SUP_EMAIL_LEN);
        if (isValidEmail(email))
            break;
        printf("  Error: enter a valid email (e.g. name@company.com.na).\n");
    }
    while (1) {
        readRequiredString("Telephone: ", phone, SUP_PHONE_LEN);
        if (isValidPhone(phone))
            break;
        printf("  Error: enter 7 to 15 digits (spaces, hyphens and a leading + are allowed).\n");
    }
    readRequiredString("Town/Location: ", town, SUP_TOWN_LEN);

    storeSupplier(id, name, email, phone, town);
    printf("\nSupplier %s added successfully.\n", name);
}

