/* ===================== BUDGET ===================== */
/* Parallel arrays: index i describes one department. */
static char   deptName[MAX_DEPTS][DEPT_NAME_LEN];
static double deptAllocated[MAX_DEPTS];
static double deptSpent[MAX_DEPTS];
static int    deptCount = 0;

/* ------------------------------------------------------------------ */
/* Calculations and helpers                                            */
/* ------------------------------------------------------------------ */

double calculateRemaining(double allocated, double spent)
{
    return allocated - spent;
}

const char *getBudgetStatus(double allocated, double spent)
{
    if (calculateRemaining(allocated, spent) >= 0.0)
        return "WITHIN BUDGET";
    return "EXCEEDED BUDGET";
}

int findDepartment(const char *name)
{
    int i;
    for (i = 0; i < deptCount; i++) {
        if (equalsIgnoreCase(deptName[i], name))
            return i;
    }
    return -1;
}

int getBudgetCount(void)              { return deptCount; }
const char *getBudgetName(int index)  { return deptName[index]; }
double getBudgetAllocated(int index)  { return deptAllocated[index]; }
double getBudgetSpent(int index)      { return deptSpent[index]; }

static void printBudgetDetail(int i)
{
    double remaining = calculateRemaining(deptAllocated[i], deptSpent[i]);

    printf("Department       : %s\n", deptName[i]);
    printf("Allocated Budget : N$%.2f\n", deptAllocated[i]);
    printf("Expenditure      : N$%.2f\n", deptSpent[i]);
    printf("Remaining Budget : N$%.2f\n", remaining);
    printf("Status           : %s\n", getBudgetStatus(deptAllocated[i], deptSpent[i]));
}

