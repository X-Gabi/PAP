void addDepartmentBudget(void)
{
    char name[DEPT_NAME_LEN];
    double amount;

    printHeader("ADD DEPARTMENT BUDGET");
    if (deptCount >= MAX_DEPTS) {
        printf("The budget list is full (%d departments).\n", MAX_DEPTS);
        return;
    }
    while (1) {
        readRequiredString("Department name: ", name, DEPT_NAME_LEN);
        if (findDepartment(name) == -1)
            break;
        printf("  Error: %s already has a budget.\n", name);
    }
    amount = readAmount("Allocated budget (N$): ", 0);

    strcpy(deptName[deptCount], name);
    deptAllocated[deptCount] = amount;
    deptSpent[deptCount] = 0.0;
    deptCount++;
    printf("\nBudget for %s saved.\n", name);
}

void recordExpenditure(void)
{
    char name[DEPT_NAME_LEN];
    int index;
    double amount;

    printHeader("RECORD EXPENDITURE");
    if (deptCount == 0) {
        printf("No department budgets exist yet. Add a budget first.\n");
        return;
    }
    readRequiredString("Department name: ", name, DEPT_NAME_LEN);
    index = findDepartment(name);
    if (index == -1) {
        printf("Department \"%s\" was not found.\n", name);
        return;
    }
    amount = readAmount("Expenditure to add (N$): ", 0);
    deptSpent[index] += amount;

    printf("\n");
    printBudgetDetail(index);
    if (deptSpent[index] > deptAllocated[index])
        printf("\nWARNING: %s has exceeded its allocated budget!\n", deptName[index]);
}

